{
  "name": "rift-runner",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "balance": "BALANCE_REPORT=1 vitest run tests/balance-report.test.ts",
    "perf": "PERF=1 vitest run tests/perf.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
